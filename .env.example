# Copy to .env on the server and fill in. Never commit .env.

# Public URL of the app, including the /tools folder (used for OAuth redirects and media links)
APP_URL=https://simonhannabuss.co.uk/tools

# Database / queue (these match docker-compose.yml)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tools:change-me@postgres:5432/tools
REDIS_URL=redis://redis:6379

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# ENCRYPTION_KEY encrypts platform tokens + 2FA secret in the database.
ENCRYPTION_KEY=
# Signs short-lived public media links for Instagram/TikTok to download from.
MEDIA_LINK_SECRET=

# Where uploaded videos live inside the container (mapped to a volume)
MEDIA_DIR=/data/media
# Delete original uploads this many days after every platform has published (0 = keep forever)
MEDIA_RETENTION_DAYS=30

# Default timezone for scheduling and insights
DEFAULT_TIMEZONE=Europe/Madrid

# --- Platforms (fill in as you create developer apps) ---
# YouTube: Google Cloud console -> OAuth client (Web). Redirect: https://simonhannabuss.co.uk/tools/oauth/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok: developers.tiktok.com. Redirect: https://simonhannabuss.co.uk/tools/oauth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram (Meta "Unified login"): developers.facebook.com → your app → Use cases → Instagram API →
# API setup with Unified login → 2. Generate access tokens → Generate token. It doesn't expire.
INSTAGRAM_ACCESS_TOKEN=
# Optional: your Instagram account ID, if the app can't find it automatically.
INSTAGRAM_ACCOUNT_ID=

# Facebook Page: a Page access token that doesn't expire (see README → Connecting Facebook).
FACEBOOK_PAGE_TOKEN=
# Optional: your Page ID, if the app can't find it automatically.
FACEBOOK_PAGE_ID=

# LinkedIn: linkedin.com/developers. Redirect: https://simonhannabuss.co.uk/tools/oauth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: LinkedIn API version (YYYYMM). Bump if LinkedIn says the version is no longer supported.
LINKEDIN_API_VERSION=202611
